# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — run `supabase start` and copy these from the output.
# For production use the values from your hosted Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Grants full access, bypassing RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email (P8) — https://resend.com
RESEND_API_KEY=

# Analytics (P11) — https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=

# Error tracking (P11) — https://sentry.io
SENTRY_DSN=
