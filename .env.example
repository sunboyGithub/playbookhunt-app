# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — run `supabase start` and copy these from the output.
# For production use the values from your hosted Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Grants full access, bypassing RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email (P8) — https://resend.com
RESEND_API_KEY=
# The verified sender address for the above, e.g. Playbook Hunt <hello@yourdomain.com>
RESEND_FROM=

# Follow-up links. Signs the one-click "it worked" links in the reminder email.
# Generate with: openssl rand -base64 32
# Leave blank locally and the sign-in still works; only the emailed links are
# unavailable. Required in production — a blank value means the cron sends mail
# whose buttons do not work.
FOLLOWUP_SECRET=

# Shared secret Vercel Cron sends as `Authorization: Bearer <secret>` to
# /api/cron/followups. Required by the `crons` entry in vercel.json.
# Leave blank locally to keep the follow-up job switched off; the route then
# refuses every request rather than running as an open mail relay.
CRON_SECRET=

# Analytics (P11) — https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=

# Error tracking (P11) — https://sentry.io
SENTRY_DSN=
